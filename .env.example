SECRET_KEY=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

WASENDERAPPI_API_KEY=
WASENDERAPPI_PHONE=

# --- Solo settings de producción (config.settings.production) ---
# Hosts/IPs permitidos, separados por coma. Ej: 16.144.59.186,midominio.com
ALLOWED_HOSTS=
# En True solo cuando haya dominio + certificado TLS servido por nginx.
DJANGO_USE_HTTPS=False

# --- Modo mantenimiento ---
# En True muestra "sitio en construcción" a todos salvo /admin/, /static/ y
# quien visite con ?preview=<MAINTENANCE_BYPASS_KEY> (se guarda en su sesión).
MAINTENANCE_MODE=False
MAINTENANCE_BYPASS_KEY=cambia-esta-clave-por-una-larga-y-unica